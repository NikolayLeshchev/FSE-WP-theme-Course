{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "udemy-plus/recipe-summary",
  "title": "Recipe Summary",
  "category": "text",
  "description": "Adds a summary section for a recipe",
  "textdomain": "udemy-plus",
  "attributes": {
    "prepTime": {
      "type": "string"
    },
    "cookTime": {
      "type": "string"
    },
    "course": {
      "type": "string"
    }
  },
  "editorScript": "file:./index.js",
  "style": "file:./index.css",
  "usesContext": [
    "postId"
  ]
}