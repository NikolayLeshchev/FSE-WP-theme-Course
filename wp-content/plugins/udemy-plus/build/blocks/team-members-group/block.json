{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "udemy-plus/team-members-group",
  "title": "Team Members Group",
  "category": "text",
  "description": "Adds a group for adding team members",
  "textdomain": "udemy-plus",
  "attributes": {
    "columns": {
      "type": "number",
      "default": 3
    },
    "imageShape": {
      "type": "string",
      "default": "hexagon"
    }
  },
  "editorScript": "file:./index.js",
  "style": "file:./index.css",
  "providesContext": {
    "udemy-plus/image-shape": "imageShape"
  },
  "example": {
    "attributes": {
      "columns": 2
    },
    "innerBlocks": [
      {
        "name": "udemy-plus/team-member",
        "attributes": {
          "name": "Nick Test",
          "title": "Developer",
          "bio": "Short descriptions of team member.",
          "imgURL": "https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?q=80&w=687&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
        }
      },
      {
        "name": "udemy-plus/team-member",
        "attributes": {
          "name": "User Test",
          "title": "CEO",
          "bio": "Short descriptions of team member.",
          "imgURL": "https://images.unsplash.com/photo-1548372290-8d01b6c8e78c?q=80&w=1169&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
        }
      }
    ]
  }
}